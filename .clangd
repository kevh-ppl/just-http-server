# Sin base de compilación, clangd analiza los archivos desde su directorio.
# Con compile_commands.json, los analiza desde la raíz del proyecto.
CompileFlags:
  Add:
    - -xc
    - -std=gnu17
    - -Wall
    - -Wextra
    - -pedantic
    - -I../include
    - -Iinclude

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
